{
  "name": "fairground",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FAIRGROUND — the honest carnival. Paint your prizes, ride a fair ladder. A Chain.wtf graph-engine game.",
  "scripts": {
    "dev": "vite --port 3120 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3121 --strictPort",
    "typecheck": "tsc --noEmit",
    "check:math": "node scripts/ladder-math.mjs 1000000 100",
    "check:title": "node scripts/check-title.ts",
    "verify:missions": "node scripts/verify-missions.mjs",
    "simulator": "chain dev casino --frontend-url http://localhost:3120"
  },
  "dependencies": {
    "@chain-protocol/casino-sdk": "^0.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@chain-protocol/cli": "^0.7.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
